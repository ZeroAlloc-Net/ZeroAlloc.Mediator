<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Mediator and ZeroAlloc.Mediator.Generator packages
    with the oldest supported .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. The generator
    package ships ZeroAlloc.Mediator.Generator.dll and the ZeroAlloc.Pipeline.Generators.dll it
    bundles in analyzers/dotnet/cs. If either references a newer Roslyn than the compiler that
    loads it, the generator is skipped with CS9057, the static Mediator class does not exist, and
    the build fails with CS0103.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      dotnet pack src/ZeroAlloc.Mediator -c Release -o artifacts -p:Version=9.9.9-local.<sha>
      dotnet pack src/ZeroAlloc.Mediator.Generator -c Release -o artifacts -p:Version=9.9.9-local.<sha>
      cd tests/ZeroAlloc.Mediator.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocMediatorVersion=9.9.9-local.<sha>
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocMediatorVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocMediatorVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocMediatorVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" Version="[$(ZeroAllocMediatorVersion)]" />
    <PackageReference Include="ZeroAlloc.Mediator.Generator" Version="[$(ZeroAllocMediatorVersion)]" />
  </ItemGroup>
</Project>
